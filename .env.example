# Copie para .env (ignorado pelo git) e preencha. Lido por `make dev`,
# `make email-test` e pelo docker compose. Nunca commite o .env.

# Acesso pela rede local no Docker.
# Use o endereço digitado no navegador, por exemplo:
PUBLIC_BASE_URL=http://192.168.1.2:7070
ALLOWED_ORIGINS=http://192.168.1.2:7070,http://localhost:7070,http://localhost:5173
COOKIE_SECURE=false
REQUIRE_HTTPS=false

# --- E-mail via Gmail ------------------------------------------------------
# Requer verificação em duas etapas na conta Google e uma "senha de app"
# (https://myaccount.google.com/apppasswords). NÃO use a senha da conta.
# Com SMTP_HOST definido, os códigos são enviados por e-mail e o /dev/outbox
# fica desativado. Remova estas linhas para voltar ao outbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=sua.conta@gmail.com
# Use aspas: a senha de app tem espaços (eles são removidos automaticamente).
SMTP_PASSWORD="abcd efgh ijkl mnop"
# Opcional: padrão é SMTP_USERNAME. Deve ser a conta ou um alias verificado no Gmail.
SMTP_FROM="GuardaDoc <sua.conta@gmail.com>"
# Alternativa com TLS implícito: SMTP_PORT=465 e SMTP_SSL=true
